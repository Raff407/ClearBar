#include <winver.h>
#include "../common/version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CLEARBAR_TAP_VERSION_MAJOR, CLEARBAR_TAP_VERSION_MINOR, CLEARBAR_TAP_VERSION_PATCH, 0
 PRODUCTVERSION CLEARBAR_TAP_VERSION_MAJOR, CLEARBAR_TAP_VERSION_MINOR, CLEARBAR_TAP_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "ClearBar contributors"
      VALUE "FileDescription", "ClearBar taskbar helper (runs inside Explorer)"
      VALUE "FileVersion", CLEARBAR_TAP_VERSION_STR
      VALUE "InternalName", "ClearBarTap"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
      VALUE "OriginalFilename", "ClearBarTap.dll"
      VALUE "ProductName", "ClearBar"
      VALUE "ProductVersion", CLEARBAR_TAP_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
