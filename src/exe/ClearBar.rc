#include <winver.h>
#include "../common/version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CLEARBAR_VERSION_MAJOR, CLEARBAR_VERSION_MINOR, CLEARBAR_VERSION_PATCH, 0
 PRODUCTVERSION CLEARBAR_VERSION_MAJOR, CLEARBAR_VERSION_MINOR, CLEARBAR_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "ClearBar contributors"
      VALUE "FileDescription", "ClearBar - transparent / blurred Windows 11 taskbar"
      VALUE "FileVersion", CLEARBAR_VERSION_STR
      VALUE "InternalName", "ClearBar"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
      VALUE "OriginalFilename", "ClearBar.exe"
      VALUE "ProductName", "ClearBar"
      VALUE "ProductVersion", CLEARBAR_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
